# Authentication
AUTH_SECRET=replace-with-a-long-random-string
JUDGE_PASSWORD=replace-with-the-password-given-to-judges
ADMIN_PASSWORD=replace-with-a-different-admin-password

# Airtable
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_NAME=Submissions

# Optional field-name overrides
AIRTABLE_TEAM_NAME_FIELD=Team Name
AIRTABLE_PROJECT_NAME_FIELD=Project Name
AIRTABLE_SUBMITTERS_FIELD=Name(s)
AIRTABLE_EMAIL_FIELD=Email
AIRTABLE_ATTENDANCE_FIELD=Attending In Person
AIRTABLE_ONE_LINER_FIELD=One Liner
AIRTABLE_DESCRIPTION_FIELD=Description
AIRTABLE_PREVIEW_FIELD=Progress Preview
AIRTABLE_TEAM_PHOTO_FIELD=Team Photo
AIRTABLE_DEMO_FIELD=Demo
AIRTABLE_REPOSITORY_URL_FIELD=Repository URL
AIRTABLE_TRACK_FIELD=Track
AIRTABLE_SUBMITTED_AT_FIELD=Submitted At
AIRTABLE_STATUS_FIELD=Status
AIRTABLE_CLAIMED_BY_FIELD=Claimed By
AIRTABLE_CLAIMED_AT_FIELD=Claimed At
AIRTABLE_CLAIM_TOKEN_FIELD=Claim Token
AIRTABLE_PROGRESS_FIELD=Progress Score
AIRTABLE_PRACTICALITY_FIELD=Practicality Score
AIRTABLE_COMPLEXITY_FIELD=Technical Complexity Score
AIRTABLE_SCORE_FIELD=Score
AIRTABLE_NOTES_FIELD=Judge Notes
AIRTABLE_COMPLETED_AT_FIELD=Completed At
AIRTABLE_REVIEWS_FIELD=Reviews
AIRTABLE_FINAL_JUDGING_FIELD=Final Judging

# Optional Status value overrides
AIRTABLE_AVAILABLE_VALUE=available
AIRTABLE_IN_PROGRESS_VALUE="in progress"
AIRTABLE_COMPLETED_VALUE=completed
