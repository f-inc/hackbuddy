# Authentication
AUTH_SECRET=replace-with-a-long-random-string
JUDGE_PASSWORD=replace-with-the-password-given-to-judges
ADMIN_PASSWORD=replace-with-a-different-admin-password

# Public deployment URL, used for canonical and social-preview links
NEXT_PUBLIC_SITE_URL=https://your-hackbuddy-domain.com

# Airtable
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_NAME=Submissions
AIRTABLE_REVIEWS_TABLE_NAME=Night Hack III - Reviews

# Multi-hackathon registry (the legacy table above remains the default event)
AIRTABLE_HACKATHONS_TABLE=Hackathons
DEFAULT_HACKATHON_NAME=Night Hack III
DEFAULT_HACKATHON_SLUG=nighthack3
DEFAULT_HACKATHON_IMAGE_URL=
DEFAULT_HACKATHON_SQUARE_IMAGE_URL=

# Optional registry field-name overrides
AIRTABLE_HACKATHON_NAME_FIELD=Name
AIRTABLE_HACKATHON_SLUG_FIELD=Slug
AIRTABLE_HACKATHON_BASE_ID_FIELD=Airtable Base ID
AIRTABLE_HACKATHON_TABLE_NAME_FIELD=Airtable Table Name
AIRTABLE_HACKATHON_REVIEWS_TABLE_NAME_FIELD=Airtable Reviews Table Name
AIRTABLE_HACKATHON_IMAGE_URL_FIELD=Image URL
AIRTABLE_HACKATHON_SQUARE_IMAGE_URL_FIELD=Square Image URL
AIRTABLE_HACKATHON_ACTIVE_FIELD=Active

# Optional field-name overrides
AIRTABLE_TEAM_NAME_FIELD=Team Name
AIRTABLE_PROJECT_NAME_FIELD=Project Name
AIRTABLE_SUBMITTERS_FIELD=Name(s)
AIRTABLE_EMAIL_FIELD=Email
AIRTABLE_ATTENDANCE_FIELD=Attending In Person
AIRTABLE_ONE_LINER_FIELD=One Liner
AIRTABLE_DESCRIPTION_FIELD=Description
AIRTABLE_PREVIEW_FIELD=Progress Preview
AIRTABLE_TEAM_PHOTO_FIELD=Team Photo
AIRTABLE_DEMO_FIELD=Demo
AIRTABLE_REPOSITORY_URL_FIELD=Repository URL
AIRTABLE_TRACK_FIELD=Track
AIRTABLE_SUBMITTED_AT_FIELD=Submitted At
AIRTABLE_STATUS_FIELD=Status
AIRTABLE_CLAIMED_BY_FIELD=Claimed By
AIRTABLE_CLAIMED_AT_FIELD=Claimed At
AIRTABLE_CLAIM_TOKEN_FIELD=Claim Token
AIRTABLE_PROGRESS_FIELD=Progress Score
AIRTABLE_PRACTICALITY_FIELD=Practicality Score
AIRTABLE_COMPLEXITY_FIELD=Technical Complexity Score
AIRTABLE_SCORE_FIELD=Score
AIRTABLE_NOTES_FIELD=Judge Notes
AIRTABLE_COMPLETED_AT_FIELD=Completed At
AIRTABLE_REVIEWS_FIELD=Reviews
AIRTABLE_FINAL_JUDGING_FIELD=Final Judging

# Optional review-table field-name overrides
AIRTABLE_REVIEW_KEY_FIELD=Review Key
AIRTABLE_REVIEW_SUBMISSION_ID_FIELD=Submission ID
AIRTABLE_REVIEW_PHASE_FIELD=Phase
AIRTABLE_REVIEW_JUDGE_FIELD=Judge Name
AIRTABLE_REVIEW_PROGRESS_FIELD=Progress Score
AIRTABLE_REVIEW_PRACTICALITY_FIELD=Practicality Score
AIRTABLE_REVIEW_COMPLEXITY_FIELD=Technical Complexity Score
AIRTABLE_REVIEW_TOTAL_FIELD=Total Score
AIRTABLE_REVIEW_NOTES_FIELD=Judge Notes
AIRTABLE_REVIEW_COMPLETED_AT_FIELD=Completed At

# Optional Status value overrides
AIRTABLE_AVAILABLE_VALUE=available
AIRTABLE_IN_PROGRESS_VALUE="in progress"
AIRTABLE_COMPLETED_VALUE=completed
